    "test:connector:owner-ui": "node scripts/connector-owner-ui-e2e.mjs",
    "test:admin-ui": "node scripts/admin-company-directory-e2e.mjs",
    "test:e2e:staging": "playwright test --config=playwright.staging.config.ts",
    "test:design": "playwright test --config=playwright.design.config.ts",
    "provision:staging": "node scripts/provision-staging-pilot.mjs",
    "provision:platform-admin": "node scripts/provision-platform-admin.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && eslint src"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sentry/react": "^10.74.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/papaparse": "^5.5.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "papaparse": "^5.7.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "playwright": "^1.64.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.5"
