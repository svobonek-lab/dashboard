{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stavbaflow.cz/schemas/connector-release-manifest-v1.json",
  "title": "StavbaFlow connector release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "image", "digest", "publishedAt", "sourceCommit"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "image": { "const": "ghcr.io/svobonek-lab/stavbaflow-connector" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
