{
  "apiBaseUrl": "https://dashboard.example.cz",
  "stateRoot": "/var/lib/stavbaflow",
  "identityPath": "/var/lib/stavbaflow/identity.json",
  "mappingPath": "/etc/stavbaflow/mapping.json",
  "syncIntervalSeconds": 60,
  "enrollmentCodeFile": "/run/secrets/enrollment_code",
  "database": {
    "driver": "postgres",
    "host": "CUSTOMER_DB_HOST",
    "port": 5432,
    "database": "CUSTOMER_DATABASE_NAME",
    "username": "CUSTOMER_READ_ONLY_USER",
    "passwordFile": "/run/secrets/source_db_password",
    "schema": "public",
    "ssl": true
  }
}
