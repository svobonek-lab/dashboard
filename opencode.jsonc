{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "supabase-ci": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=xwzweltjvreqhjpbjrxa&read_only=true&features=database,debugging,docs",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:SUPABASE_ACCESS_TOKEN}"
        }
      }
    }
  }
}