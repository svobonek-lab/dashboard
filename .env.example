# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Gemini model is fixed in lib/gemini.ts: gemini-3.8-flash.
# Separate 32+ character secret used to derive one webhook token per company.
AI_INBOX_SIGNING_SECRET=

# Scheduled dead-lead alert delivery. CRON_SECRET protects the worker route.
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM="StavbaFlow <notifications@example.invalid>"

# APP_URL: Exact HTTPS origin of the login application, without a path.
# Required by invitation and recovery workers. It must also be present in the
# staging Supabase Auth redirect allow list. Unsafe or missing values fail closed.
APP_URL="https://app.example.invalid"

# Vercel surface: unified (default), landing (public sales), or app (real login)
VITE_DEPLOYMENT_SURFACE=unified
# Only needed on the landing Vercel project; points to the app/login project.
VITE_APP_URL=
# Preferred explicit target for every public demo action. Use the dashboard
# deployment HTTPS URL including /demo, with no query or fragment.
VITE_DEMO_URL=

# Supabase client API uses the project's HTTPS URL for PostgREST/Auth requests.
# This is not a PostgreSQL connection string; port 6543 is only for raw PostgreSQL
# clients using Supavisor transaction mode. Such a client would need max: 1,
# SSL, and transaction-mode-safe queries. No raw serverless PostgreSQL client is
# configured in this project today; see docs/serverless-database-pooling.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Keep false until production RLS policies, grants, and indexes are verified.
VITE_APP_SCHEMA_READS=false

# Server-only Stripe endpoint signing secret (starts with whsec_). Never use VITE_.
STRIPE_WEBHOOK_SECRET=
# Server-only Stripe key and approved recurring Prices. Never prefix with VITE_.
STRIPE_SECRET_KEY=
# Preview/staging defaults to test and rejects live keys. Set live only in a
# separately reviewed production release.
STRIPE_BILLING_MODE=test
# STRIPE_PRICE_ID remains a backwards-compatible alias for the pilot plan.
STRIPE_PRICE_ID=
STRIPE_PRICE_PILOT_ID=
STRIPE_PRICE_STARTER_ID=
STRIPE_PRICE_GROWTH_ID=
# Exact HTTPS origin that Stripe returns owners to after Checkout.
BILLING_RETURN_URL=
# Isolated staging only; exact project allowlist enforced in pilotWrites.ts.
VITE_PILOT_WRITES=false
# Exposes the reviewed owner connector workspace. Keep false until its staging
# SQL contract and connector acceptance checks have passed in that deployment.
VITE_CONNECTOR_ENABLED=false
# Keep BYODB off until the isolated staging acceptance and source-write review pass.
VITE_BYODB_ENABLED=false
# Only immutable, reviewed GHCR image references are accepted by the Synology bundle builder.
VITE_CONNECTOR_IMAGE=

# Server-side Supabase `supabase-js` clients also use the HTTPS project API URL.
# Do not replace it with a PostgreSQL/Supavisor connection string.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_URL="https://your-staging-project.supabase.co"
STAGING_SUPABASE_PROJECT_REF="your-staging-project-ref"
STAGING_PLATFORM_ADMIN_USER_ID=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_APP_URL=

# Public ingest DSN for error monitoring. Sentry tags may contain only the
# internal company UUID and one of the approved roles; never add user/email data.
# Get this from Sentry.io -> Settings -> Projects -> Client Keys (DSN)
VITE_SENTRY_DSN=

# Company identification & legal contact details (for Landing Page & Legal documents)
VITE_COMPANY_NAME=
VITE_COMPANY_ICO=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_EMAIL=
VITE_COMPANY_PHONE=
VITE_BOOKING_URL=

# HMAC key for anonymous public-intake IP rate-limit hashes (server only, 32+ random characters).
PUBLIC_INTAKE_HASH_SECRET=replace-with-at-least-32-random-characters

# Kept disabled until paid-registration producer and staging acceptance pass.
PAID_ONBOARDING_ENABLED=false
# Enable only on the accepted staging app deployment, together with the server gate.
VITE_PAID_REGISTRATION_ENABLED=false
