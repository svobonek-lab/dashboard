# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Exact HTTPS origin of the login application, without a path.
# Required by invitation and recovery workers. It must also be present in the
# staging Supabase Auth redirect allow list. Unsafe or missing values fail closed.
APP_URL="https://app.example.invalid"

# Vercel surface: unified (default), landing (public sales), or app (real login)
VITE_DEPLOYMENT_SURFACE=unified
# Only needed on the landing Vercel project; points to the app/login project.
VITE_APP_URL=

# Supabase configuration for client-side queries
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Keep false until production RLS policies, grants, and indexes are verified.
VITE_APP_SCHEMA_READS=false
# Isolated staging only; exact project allowlist enforced in pilotWrites.ts.
VITE_PILOT_WRITES=false
# Exposes the reviewed owner connector workspace. Keep false until its staging
# SQL contract and connector acceptance checks have passed in that deployment.
VITE_CONNECTOR_ENABLED=false

# Supabase server-side configuration (required for secure serverless API routes & employee management)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_URL="https://oncmtmrhmjlerbwkrecv.supabase.co"
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_APP_URL=

# Sentry DSN for error monitoring
# Get this from Sentry.io -> Settings -> Projects -> Client Keys (DSN)
VITE_SENTRY_DSN=

# Company identification & legal contact details (for Landing Page & Legal documents)
VITE_COMPANY_NAME=
VITE_COMPANY_ICO=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_EMAIL=
VITE_COMPANY_PHONE=
VITE_BOOKING_URL=

